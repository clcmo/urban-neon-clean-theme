{
  "name": "urban-neon-clean-theme",
  "displayName": "Urban Neon Clean Theme (Dark & Light)",
  "description": "Temas Dark e Light para VS Code com contraste WCAG validado e Clean Architecture.",
  "version": "1.1.1",
  "publisher": "clcmo",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clcmo/urban-neon-clean-theme.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.18"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Urban Neon Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/urban-neon-dark.json"
      },
      {
        "label": "Urban Neon Light",
        "uiTheme": "vs",
        "path": "./themes/urban-neon-light.json"
      }
    ]
  },
  "icon": "assets/icon.png",
  "scripts": {
    "build:icon": "node --experimental-strip-types src/cli/generate-icon.ts",
    "build:readme": "node scripts/build-readme.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:themes": "node --experimental-strip-types src/cli/build.ts",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "package:vsix": "node -e \"fs.mkdirSync('dist',{recursive:true})\" && npx @vscode/vsce package --no-dependencies --out dist/urban-neon-clean-theme.vsix",
    "validate:themes": "node scripts/validate-themes.mjs"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/vsce": "^4.1.1",
    "marked": "^18.2.1",
    "typescript": "^5.7.0"
  },
  "bugs": {
    "url": "https://github.com/clcmo/urban-neon-clean-theme/issues"
  },
  "homepage": "https://github.com/clcmo/urban-neon-clean-theme#readme"
}
