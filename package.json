{
  "name": "urban-neon-clean-theme",
  "displayName": "Urban Neon Clean Theme (Dark & Light)",
  "description": "Temas Dark e Light para VS Code com contraste WCAG validado e Clean Architecture.",
  "version": "0.1.0",
  "publisher": "clcmo",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/clcmo/vscode-theme-clean-arch.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Urban Neon Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/urban-neon-dark.json"
      },
      {
        "label": "Urban Neon Light",
        "uiTheme": "vs",
        "path": "./themes/urban-neon-light.json"
      }
    ]
  },
  "scripts": {
    "build:readme": "node scripts/build-readme.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:themes": "node --experimental-strip-types src/cli/build.ts",
    "package:vsix": "npx @vscode/vsce package --no-dependencies",
    "release:dry-run": "npx release-please release-pr --dry-run --repo-url=https://github.com/clcmo/vscode-theme-clean-arch --token=${GITHUB_TOKEN:-local}"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "marked": "^18.2.1",
    "release-please": "^17.11.2",
    "typescript": "^7.0.2"
  }
}
